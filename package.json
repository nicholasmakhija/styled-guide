{
  "name": "styled-guide",
  "version": "1.0.0",
  "description": "Documentation site for [@n3e/styled](https://www.npmjs.com/package/@n3e/styled) npm package.",
  "main": "index.js",
  "scripts": {
    "clean:bin": "rimraf ./bin",
    "clean:dist": "rimraf ./dist",
    "clean": "run-p clean:**",
    "copy": "copyfiles -u 2 \"src/assets/**/*.*\" dist",
    "scaffold": "node -r @babel/register scripts/scaffold",
    "bundle": "rollup --config --exports named",
    "build": "run-s clean copy scaffold bundle",
    "dev": "NODE_ENV=development run-s --silent build",
    "prod": "NODE_ENV=production run-s --silent build",
    "update": "run-s scaffold bs:reload",
    "watch:assets": "onchange -k \"src/assets/**/*.*\" -- npm run copy",
    "watch:html": "onchange -k \"src/app/**/*.html\" -- npm run update",
    "watch:rollup": "rollup -c -w --watch.onEnd=\"npm run update\"",
    "watch": "run-p --silent watch:**",
    "start": "npm-run-all --silent dev -p watch bs:serve",
    "bs:serve": "browser-sync start -s dist --port 8088",
    "bs:reload": "browser-sync reload --port 8088"
  },
  "author": "Nicholas Makhija",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.26.8",
    "@babel/preset-env": "^7.26.8",
    "@babel/preset-react": "^7.26.3",
    "@babel/register": "^7.25.9",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "browser-sync": "^3.0.3",
    "copyfiles": "^2.4.1",
    "glob": "^11.0.1",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.34.6",
    "rollup-plugin-gzip": "^4.0.1"
  },
  "dependencies": {
    "@n3e/styled": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
